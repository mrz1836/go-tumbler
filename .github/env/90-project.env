# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-tumbler
# Load Order: 90 (loaded after all tool defaults, overrides earlier files)
#
# This file contains project-specific configuration that overrides defaults from
# core (00-core.env) and tool-specific (10-*.env, 20-*.env) configuration files.
#
# Override in: 99-local.env (local development only, git-ignored)
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

GO_PRIMARY_VERSION=1.25.x
GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_VERSION=1.25.x

# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Coverage Provider Selection (overrides internal default to use codecov)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage Exclusions (aligned with codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/,test/,vendor/,testdata/,docs/

# ================================================================================================
# 🛡️ VULNERABILITY EXCLUSIONS
# ================================================================================================

# go-tumbler depends only on the Go standard library plus golang.org/x/crypto and
# golang.org/x/sys (test-only: testify). Its reachable code is clean.
#
# SECURITY_VULN_EXCLUDES is the shared source of truth (the CI workflow merges it
# into every scanner). Note: `magex deps:audit` (govulncheck) reads MAGE_X_CVE_EXCLUDES
# directly via os.Getenv AFTER loading these env files, and the loader force-sets each
# key (os.Setenv) — so an EMPTY value here would override the workflow's resolved list.
# Set the real value in BOTH so govulncheck and OSV-Scanner exclude it consistently.
#
# GO-2026-5932 (2026-08-14): golang.org/x/crypto/openpgp is unmaintained/unsafe. It
# ships inside the golang.org/x/crypto module (required for argon2/scrypt/
# chacha20poly1305), but go-tumbler does NOT import or call any openpgp symbol —
# `govulncheck ./...` reports it only as "a module you require, but your code doesn't
# call it" (0 affecting, exit 0). The advisory has no fixed version (a permanent
# deprecation), so it cannot be cleared by upgrading; if OpenPGP is ever needed, use
# github.com/ProtonMail/go-crypto/openpgp instead. Re-evaluate then.
SECURITY_VULN_EXCLUDES=GO-2026-5932
MAGE_X_CVE_EXCLUDES=GO-2026-5932
NANCY_EXCLUDES=
